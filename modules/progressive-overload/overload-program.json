  "method": "double-progression",
  "rules": {
    "effort": "Stop every working set 1-2 reps short of failure (RIR 1-2). The last set of a small isolation lift may go to failure.",
    "addReps": "Keep the same weight. Each session, try to add at least 1 rep to one set (usually the lowest one) with the same form and full range of motion.",
    "addLoad": "When every working set reaches the top of the rep range at RIR 1-2, add the smallest jump for that equipment next session.",
    "afterJump": "Reps fall back toward the bottom of the range. That is expected. Build back up to the top again.",
    "jumpTooBig": "If the first set at the new weight falls below the bottom of the range, go back to the old weight and add 1-2 more reps above the top first, or use a smaller jump if one exists.",
    "badSession": "One bad session means nothing. Repeat the same targets next time.",
    "dropRule": "If a main lift drops for 2+ sessions in a row: check sleep, pre-workout food (Meal 1 at 2 pm + Gatorade) and total volume before touching calories.",
    "stallRule": "If a lift gets no extra reps for 3 sessions in a row at the same weight: take 5-10% off, rebuild to the top of the range, then try the jump again.",
    "deload": "Every 6-8 weeks, or when several main lifts stall together: one 8-day cycle with the same weights, half the sets, stopping 3-4 reps short of failure.",
    "rest": { "compound": "2.5-3 min", "isolation": "1-2 min" },
    "cutExpectation": "While cutting at 2,000 kcal, holding weights and reps is a win. Expect small, uneven rep gains; big load jumps will be rare."
  },
  "repRanges": {
    "compound": { "min": 8, "max": 12 },
    "smallIsolation": { "min": 10, "max": 15, "why": "The smallest jump on light cables and dumbbells is 15-35% of the load, so a wider range is needed before each jump." },
    "hip": { "min": 12, "max": 20 },
    "calves": { "min": 10, "max": 15 }
  },
